# Helius RPC endpoints (get yours at https://helius.dev)
HELIUS_HTTP=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
HELIUS_WSS=wss://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Wallets to follow (comma separated)
WALLETS=WALLET_PUBKEY_1,WALLET_PUBKEY_2

# Jito Bundle Configuration
# Regions: tokyo, ny, frankfurt, amsterdam (pick closest)
JITO_URL=https://tokyo.mainnet.block-engine.jito.wtf
JITO_TIP_LAMPORTS=20000
JITO_AUTH=

# Keypair for signing transactions (path to JSON file)
# Generate with: solana-keygen new -o ~/my-keypair.json
KEYPAIR_PATH=

# Jupiter API key (optional, improves rate limits - get at https://station.jup.ag/)
# JUP_API_KEY=

# Reconciliación: vender posiciones untracked cuando líder vende (default: true)
# RECONCILE_UNTRACKED_SELL=false  # usar para no tocar bolsas viejas

# ========== SNIPER MODE (Execution) ==========
# Modo de ejecución: "sniper" = 1 intento ultra rápido | "retry" = reintentos por slippage
EXECUTION_MODE=sniper
SNIPER_SINGLE_SHOT=true
MAX_SLIPPAGE_BPS_SNIPER=1500
MIN_OUT_BPS_GUARD=0
PRIORITY_FEE_MODE=jito
JITO_TIP_LAMPORTS_SNIPER=20000
COMPUTE_UNIT_LIMIT=1400000
COMPUTE_UNIT_PRICE_MICROLAMPORTS=100000
PREFLIGHT_MODE=skip_preflight
QUOTE_BEFORE_SEND=true
QUOTE_MAX_AGE_MS=300
AMOUNT_SCALE_ON_LOW_LIQUIDITY=false
SCALE_FACTOR=0.5
COOLDOWN_MISS_MS=30000
CONFIRM_TIMEOUT_SECS=10
MAX_LEADER_LAG_MS=1200
MIN_TRADE_SOL_SNIPER=0.01
